pipeline {
    agent any

    stages {
        stage('Hello A') {
            steps {
                echo 'Hello World A'
            }
        }
        stage('run linux command') {
            steps {
                sh ""
				date
				cal
				dir
				""
				            
			}
		}	
        stage('show web page') {
            steps {
                sh 'cat index.html'

			}
		}	
	}
	
}	
